{
    "name": "tyhpdef/webmozart-assert-impl",
    "description": "Implementation package for tyhpdef/webmozart-assert. Require tyhpdef/webmozart-assert, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.4.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/vimeo-psalm": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/webmozart-assert"
        }
    },
    "require": {
        "php": ">=8.2",
        "webmozart/assert": "2.4.1"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/vimeo-psalm": "@dev"
    }
}
